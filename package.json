{
  "name": "nest-nabber",
  "private": true,
  "type": "module",
  "workspaces": [
    "web-next",
    "studio"
  ],
  "scripts": {
    "dev": "npm run dev -w web-next",
    "build": "npm run build -w web-next",
    "check": "npm run typecheck -w web-next",
    "preview": "npm run preview -w web-next",
    "studio": "npm run dev -w studio",
    "studio:build": "npm run build -w studio",
    "test": "node --test tests/*.test.mjs && npm run test:data -w web-next"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "smol-toml": "1.9.0",
    "js-yaml@^3.13.1": "3.15.2",
    "typeid-js": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@portabletext/block-tools": "6.0.2",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.0.1"
  }
}
