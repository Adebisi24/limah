---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { getArticles, href } from '../lib/content';
const all = await getArticles();
const featured = all.find((a) => a.kind === 'finds');
---

<Base title="Thoughtful finds for your home">
  <div class="wrap">
    <header class="page-intro">
      <p class="eyebrow">THE NEST NABBER SHOPPING EDIT</p>
      <h1>Good finds. Better living.</h1>
      <p>
        Considered pieces, useful buying advice, and rooms you'll want to make
        your own.
      </p>
    </header>
    {featured && (
      <section class="hero">
        <a class="hero-image" href={href(featured)}>
          <img
            src={featured.image}
            alt={featured.alt}
            width="1000"
            height="700"
          />
        </a>
        <div class="hero-copy">
          <p class="eyebrow">THE LATEST EDIT</p>
          <h2>{featured.title}</h2>
          <p>{featured.excerpt}</p>
          <a class="text-link" href={href(featured)}>
            Discover the edit →
          </a>
        </div>
      </section>
    )}
    <nav class="format-nav" aria-label="Shopping formats">
      {[
        'Shopping Finds',
        'Best Products',
        'Buying Guides',
        'Shop the Look',
      ].map((label, i) => (
        <a href={'#' + ['finds', 'best', 'guide', 'look'][i]}>{label} ↘</a>
      ))}
    </nav>
    <section class="section">
      <h2>Shop by room</h2>
      <div class="link-list">
        {['Bedroom', 'Living Room', 'Kitchen', 'Bathroom'].map((r) => (
          <a href={'/rooms/' + r.toLowerCase().replaceAll(' ', '-') + '/'}>
            {r}
            <span>→</span>
          </a>
        ))}
      </div>
    </section>
    {[
      ['finds', 'Shopping Finds'],
      ['look', 'Shop the Look'],
      ['best', 'Best Products'],
      ['guide', 'Buying Guides'],
    ].map(([kind, title]) => (
      <div id={kind}>
        <Section
          title={title}
          articles={all.filter((a) => a.kind === kind).slice(0, 4)}
        />
      </div>
    ))}
    <Section
      title="The latest shopping stories"
      articles={all.filter((a) => a.kind !== 'inspiration').slice(-8)}
    />
  </div>
</Base>
